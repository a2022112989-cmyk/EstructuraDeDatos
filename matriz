#include <iostream>
using namespace std;

#define MAX 100

void cargar(int nota[MAX][MAX], int n);
void mostrar(int nota[MAX][MAX], int n);

int main()
{
    int notes[MAX][MAX];
    int n;

    do {
        cout << "Ingrese el nro de elementos: ";
        cin >> n;
    } while(n <= 0 || n > MAX);

    cargar(notes, n);
    mostrar(notes, n);

    return 0;
}

void cargar(int nota[MAX][MAX], int n) {
    cout << "Ingresa los datos: " << endl;

    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            cout << "Nota [" << i << "][" << j << "]: ";
            cin >> nota[i][j];
        }
    }
}

void mostrar(int nota[MAX][MAX], int n){
    cout << "\nMatriz de notas:\n";

    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            cout << nota[i][j] << " ";
        }
        cout << endl;
    }
}
