#pragma once
#include "Nodo.h"
class Pila
{
	Nodo* tope;
public:
	Pila();
	void push();
	void pop();
	void show();
	void top();
	void size();
};
#pragma once
#include <iostream>
#include <string>
using namespace std;
class Nodo
{
public:
	int dato;
	string nombre;
	Nodo* sig;
};
#include "Pila.h"

Pila::Pila() {
	tope = NULL;
}

void Pila::push() {
	int valor;
	string valor2;
	Nodo* aux = new Nodo;
	system("cls");
	cout << "Ingresa el ID del proceso: ";
	cin >> valor;
	cin.ignore();
	cout << "Ingresa el nombre del proceso: ";
	getline(cin, valor2);
	aux->dato = valor;
	aux->nombre = valor2;
	aux->sig = NULL;

	if (tope != NULL)
		aux->sig = tope;
	tope = aux;
	cout << "Nuevo proceso insertado";
}

void Pila::pop() {
	Nodo* temp = new Nodo;
	if (tope == NULL) {
		system("cls");
		cout << "\nLa pila esta vacia!\n\n";
		system("pause");
	}
	else {
		temp = tope;
		tope = tope->sig;
		system("cls");
		cout << "\nEl proceso eliminado es: " << temp->dato << " - " << temp->nombre << "\n" << endl;
		delete temp;
		system("pause");
	}
}

void Pila::show() {
	Nodo* aux1 = tope;
	if (tope == NULL) {
		system("cls");
		cout << "\nLa pila esta vacia!\n\n";
		system("pause");
	}
	else {
		system("cls");
		cout << "Procesos:\n" << endl;
		while (aux1 != NULL) {
			cout << aux1->dato << " - " << aux1->nombre << "\n" << endl;
			aux1 = aux1->sig;
		}
		system("pause");
	}
}
void Pila::top() {
	Nodo* aux1 = tope;
	if (tope == NULL) {
		system("cls");
		cout << "\nLa pila esta vacia!\n\n";
		system("pause");
	}
	else {
		system("cls");
		cout << "Proceso TOP:\n" << endl;
		cout << aux1->dato << " - " << aux1->nombre << "\n" << endl;
		system("pause");
	}
}
void Pila::size() {
	Nodo* aux1 = tope;
	if (tope == NULL) {
		system("cls");
		cout << "\nLa pila esta vacia!\n\n";
		system("pause");
	}
	else {
		int contador = 0;
		while (aux1) {
			contador++;
			aux1 = aux1->sig;
		}
		system("cls");
		cout << "El tamano de la pila es: '" << contador << "'\n" << endl;
		system("pause");
	}
}
